// Régua do Híbrido — modelo de dados (MySQL / Hostinger)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum Role {
  ADMIN
  ACCOUNTANT
}

enum Veredito {
  OPTAR
  LIMITROFE
  NEGOCIAR
  MANTER
}

enum Plano {
  MENSAL
  ANUAL
}

enum MetodoPagamento {
  CARTAO
  PIX
}

enum PagamentoStatus {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
  EXPIRADO
  ESTORNADO
}

enum AssinaturaStatus {
  PENDENTE
  ATIVA
  PAUSADA
  CANCELADA
}

enum LeadStatus {
  NOVO
  CONTATADO
  CONVERTIDO
  DESCARTADO
}

model User {
  id         String   @id @default(cuid())
  nome       String   @db.VarChar(120)
  email      String   @unique @db.VarChar(191)
  senha      String   @db.VarChar(100) // hash bcrypt
  role       Role     @default(ACCOUNTANT)
  // White-label: nome do escritório exibido no cabeçalho do PDF
  escritorio String?  @db.VarChar(160)
  crc        String?  @db.VarChar(30)
  ativo      Boolean  @default(true)
  telefone   String?  @db.VarChar(20)
  // Assinatura: acesso ao simulador liberado até esta data (ADMIN sempre tem acesso)
  acessoAte  DateTime?
  // Teste grátis já utilizado (só um por conta)
  trialUsadoEm DateTime?
  // White-label: logo do escritório no PDF (PNG/JPG guardado no banco — sobrevive a deploys)
  logo           Bytes?    @db.MediumBlob
  logoMime       String?   @db.VarChar(20)
  logoAtualizadaEm DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies   Company[]
  assinaturas Assinatura[]
  pagamentos  Pagamento[]

  @@map("users")
}

model Company {
  id        String   @id @default(cuid())
  nome      String   @db.VarChar(160)
  cnpj      String   @db.VarChar(14) // somente dígitos
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulations Simulation[]

  // O mesmo CNPJ pode existir para contadores diferentes, mas não duplicado no mesmo tenant
  @@unique([userId, cnpj])
  @@index([userId])
  @@map("companies")
}

model Simulation {
  id        String   @id @default(cuid())
  companyId String
  // Snapshot dos inputs + premissas usados no cálculo (SimulationInput)
  inputs    Json
  // Snapshot dos resultados (SimulationResult) — garante que o PDF reflita o cálculo da época
  resultado Json
  veredito  Veredito
  titulo    String?  @db.VarChar(160)
  data      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, data])
  @@map("simulations")
}

// Assinatura recorrente no cartão (Mercado Pago "preapproval")
model Assinatura {
  id              String           @id @default(cuid())
  userId          String
  plano           Plano
  valor           Decimal          @db.Decimal(10, 2)
  status          AssinaturaStatus @default(PENDENTE)
  mpPreapprovalId String?          @unique @db.VarChar(64)
  emailPagador    String?          @db.VarChar(191)
  // CPF/CNPJ do titular do cartão (evita repetir o teste grátis com outra conta)
  docPagador      String?          @db.VarChar(20)
  // Dias de teste grátis antes da 1ª cobrança (0 = sem teste)
  trialDias       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@index([userId, status])
  @@index([emailPagador])
  @@index([docPagador])
  @@map("assinaturas")
}

// Cada cobrança: Pix avulso (30/365 dias) ou parcela aprovada da assinatura no cartão
model Pagamento {
  id           String          @id @default(cuid())
  userId       String
  assinaturaId String?
  plano        Plano
  metodo       MetodoPagamento
  valor        Decimal         @db.Decimal(10, 2)
  status       PagamentoStatus @default(PENDENTE)
  mpPaymentId  String?         @unique @db.VarChar(64)
  pixQrCode    String?         @db.Text
  pixQrBase64  String?         @db.MediumText
  pixExpiraEm  DateTime?
  aprovadoEm   DateTime?
  // Período de acesso concedido por este pagamento
  acessoDe     DateTime?
  acessoAte    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  assinatura Assinatura? @relation(fields: [assinaturaId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([assinaturaId])
  @@map("pagamentos")
}

model Lead {
  id        String     @id @default(cuid())
  nome      String     @db.VarChar(120)
  email     String     @db.VarChar(191)
  telefone  String     @db.VarChar(20)
  crc       String     @db.VarChar(30)
  status    LeadStatus @default(NOVO)
  origem    String?    @db.VarChar(60)
  createdAt DateTime   @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}
