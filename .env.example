# MySQL (Hostinger) — formato: mysql://USUARIO:SENHA@HOST:3306/BANCO
DATABASE_URL="mysql://usuario:senha@srvXXX.hstgr.io:3306/regua_hibrido"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte"

# Usuário ADMIN criado pelo seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@reguadohibrido.com.br"
SEED_ADMIN_PASSWORD="troque-esta-senha"
SEED_ADMIN_NAME="Administrador"

# Mercado Pago — Suas integrações → sua aplicação → Credenciais de produção
MP_ACCESS_TOKEN="APP_USR-..."
# Chave pública (mesma tela) — usada pelo formulário de cartão embutido no site
MP_PUBLIC_KEY="APP_USR-..."
# Suas integrações → Webhooks → "Assinatura secreta" (valida as notificações)
MP_WEBHOOK_SECRET=""
# URL pública do site (webhook e retorno do checkout). Se vazio, usa NEXTAUTH_URL.
APP_URL="https://app.seudominio.com.br"
